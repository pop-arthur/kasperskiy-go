# Compose reads .env automatically; the Go process reads exported environment only.
LOG_LEVEL=INFO

# Local binary. Compose sets HTTP_ADDR=0.0.0.0:8080 inside the API container.
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
# Host-side API publication in Compose.
API_PORT=8080

# These credentials are examples for local development only.
# Compose sets POSTGRES_HOST=postgres and POSTGRES_PORT=5432 inside the API.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=threats
POSTGRES_USER=threats
POSTGRES_PASSWORD=local_development_only
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_CONNECT_TIMEOUT=5s
